# Cached data: regenerable from the OpenF1 API, too large for git
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
# The three small files the app needs (about 1 MB, derived from OpenF1; docs/DEPLOY.md), so a fresh clone runs.
!data/processed/lap_dataset.parquet
!data/processed/driver_names.json
!data/processed/neutralisations.json
!data/processed/calibration.json
!data/processed/race_selection.json

